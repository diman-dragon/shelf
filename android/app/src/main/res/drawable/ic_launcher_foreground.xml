<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Subtle warm glow around center -->
    <path
        android:pathData="M54,28 A26,26 0 1,0 54,80 A26,26 0 1,0 54,28 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="30"
                android:type="radial">
                <item android:color="#35E5AA52" android:offset="0.0" />
                <item android:color="#00E5AA52" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Headband of headphones -->
    <path
        android:pathData="M33,56 C33,40 42,28 54,28 C66,28 75,40 75,56"
        android:strokeWidth="5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="33"
                android:startY="28"
                android:endX="75"
                android:endY="28"
                android:type="linear">
                <item android:color="#D89947" android:offset="0.0" />
                <item android:color="#F7CE8C" android:offset="0.5" />
                <item android:color="#D89947" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Headband padding inner layer -->
    <path
        android:pathData="M38,50 C38,40 45,33 54,33 C63,33 70,40 70,50"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeColor="#55FFFFFF" />

    <!-- Left Ear Cup -->
    <path
        android:pathData="M27,51 C27,48.5 29.5,46 32.5,46 C35.5,46 38,48.5 38,51 L38,65 C38,67.5 35.5,70 32.5,70 C29.5,70 27,67.5 27,65 Z"
        android:fillColor="#E6A857" />
    <path
        android:pathData="M29,53 C29,51.5 30.5,50 32.5,50 C34.5,50 36,51.5 36,53 L36,63 C36,64.5 34.5,66 32.5,66 C30.5,66 29,64.5 29,63 Z"
        android:fillColor="#4A2C18" />

    <!-- Right Ear Cup -->
    <path
        android:pathData="M70,51 C70,48.5 72.5,46 75.5,46 C78.5,46 81,48.5 81,51 L81,65 C81,67.5 78.5,70 75.5,70 C72.5,70 70,67.5 70,65 Z"
        android:fillColor="#E6A857" />
    <path
        android:pathData="M72,53 C72,51.5 73.5,50 75.5,50 C77.5,50 79,51.5 79,53 L79,63 C79,64.5 77.5,66 75.5,66 C73.5,66 72,64.5 72,63 Z"
        android:fillColor="#4A2C18" />

    <!-- Book Base / Shelf shadow -->
    <path
        android:pathData="M34,75 C43,73 50,75 54,77 C58,75 65,73 74,75 L74,78 C65,76 58,78 54,80 C50,78 43,76 34,78 Z"
        android:fillColor="#5A351B" />

    <!-- Left Book Page -->
    <path
        android:pathData="M36,58 C44,57 51,59 53.5,61 L53.5,75 C51,73 44,71 36,72 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="36"
                android:startY="58"
                android:endX="53.5"
                android:endY="75"
                android:type="linear">
                <item android:color="#FBF4E8" android:offset="0.0" />
                <item android:color="#E8D9C5" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right Book Page -->
    <path
        android:pathData="M72,58 C64,57 57,59 54.5,61 L54.5,75 C57,73 64,71 72,72 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="72"
                android:startY="58"
                android:endX="54.5"
                android:endY="75"
                android:type="linear">
                <item android:color="#F3E7D5" android:offset="0.0" />
                <item android:color="#DFCBB3" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Book Spine center line -->
    <path
        android:pathData="M54,61 L54,76"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeColor="#C5965A" />

    <!-- Text line accents on left page -->
    <path
        android:pathData="M40,63 C44,62.5 47,63.2 49.5,64 M40,66.5 C44,66 47,66.7 49.5,67.5 M40,70 C43,69.5 46,70.2 48,70.8"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:strokeColor="#9B816B" />

    <!-- Text line accents on right page -->
    <path
        android:pathData="M68,63 C64,62.5 61,63.2 58.5,64 M68,66.5 C64,66 61,66.7 58.5,67.5 M68,70 C65,69.5 62,70.2 60,70.8"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:strokeColor="#9B816B" />

    <!-- Audio wave bursts rising above book spine -->
    <path
        android:pathData="M50,53 L50,47 M54,55 L54,43 M58,53 L58,47"
        android:strokeWidth="2.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="54"
                android:startY="55"
                android:endX="54"
                android:endY="43"
                android:type="linear">
                <item android:color="#E6A857" android:offset="0.0" />
                <item android:color="#FFE8B5" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
